{
  "name": "liar-game-web",
  "version": "1.4.1",
  "description": "라이어 게임 (Word Wolf) 온라인 멀티플레이어 웹 애플리케이션",
  "main": "dist/index.js",
  "scripts": {
    "dev": "concurrently \"tsx watch --env-file-if-exists=.env src/index.ts\" \"tailwindcss -i src/styles/app.css -o public/css/tailwind.css --watch\"",
    "build": "tailwindcss -i src/styles/app.css -o public/css/tailwind.css --minify && tsc",
    "build:css": "tailwindcss -i src/styles/app.css -o public/css/tailwind.css --minify",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "liar-game",
    "word-wolf",
    "multiplayer",
    "socket.io"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "ejs": "^3.1.9",
    "express": "^4.18.2",
    "nanoid": "^3.3.11",
    "pino": "^10.1.0",
    "pino-pretty": "^13.1.3",
    "socket.io": "^4.7.2"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.2.2",
    "@types/ejs": "^3.1.5",
    "@types/express": "^4.17.21",
    "@types/node": "^20.10.0",
    "concurrently": "^9.2.1",
    "tsx": "^4.6.0",
    "typescript": "^5.3.2",
    "vitest": "^4.1.4"
  }
}
