{
  "name": "liar-game-web",
  "version": "2.0.0-dev",
  "description": "라이어 게임 (Word Wolf) 온라인 멀티플레이어 웹 애플리케이션",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -n server,client -c blue,magenta \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "tsx watch --env-file-if-exists=.env server/index.ts",
    "dev:client": "vite",
    "build": "npm run build:client && npm run build:server",
    "build:client": "vite build",
    "build:server": "tsc -p tsconfig.server.json",
    "start": "node dist/server/index.js",
    "typecheck": "tsc -p tsconfig.server.json --noEmit && svelte-check --tsconfig tsconfig.client.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@colyseus/schema": "4.0.31",
    "@colyseus/ws-transport": "0.17.13",
    "colyseus": "0.17.10",
    "express": "5.2.1",
    "nanoid": "6.0.1",
    "pino": "10.3.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@colyseus/sdk": "0.17.43",
    "@colyseus/testing": "0.17.11",
    "@sveltejs/vite-plugin-svelte": "7.3.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/express": "5.0.6",
    "@types/node": "26.2.0",
    "concurrently": "10.0.5",
    "pino-pretty": "13.1.3",
    "svelte": "5.56.9",
    "svelte-check": "4.7.6",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.12",
    "typescript": "5.9.3",
    "vite": "8.2.1",
    "vitest": "4.1.11"
  }
}
