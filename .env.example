# 이 파일을 .env 로 복사해서 사용한다. .env 는 커밋하지 않는다.

# 서버 포트 (기본 2567). 비워두면 개발 시 빈 포트를 자동으로 찾는다.
# 값을 지정하면 그 포트를 고수하고, 점유 중이면 실패한다.
PORT=2567

# 절대 URL 생성용 (OG 태그, sitemap). 기본 https://liar-game.guest-01.dev
BASE_URL=http://localhost:2567

# 로그 레벨 (기본: production이면 info, 아니면 debug)
LOG_LEVEL=debug

# production 이면 빌드된 클라이언트(dist/public)를 서빙하고 JSON 로그를 쓴다
# 출처(Origin) 제한은 구현하지 않았다 (체크리스트 C4 보류)
NODE_ENV=development

# 설정하면 인앱 피드백 기능이 켜진다. 서버 시작 시 유효성을 검증한다.
# 클라이언트에 절대 노출되지 않는다.
DISCORD_WEBHOOK_URL=
