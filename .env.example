# 이 파일을 .env 로 복사해서 사용한다. .env 는 커밋하지 않는다.

# 서버 포트 (기본 3000)
PORT=3000

# 절대 URL 생성용 (OG 태그, sitemap). 기본 https://liar-game.guest-01.dev
BASE_URL=http://localhost:3000

# 프로덕션 CORS 허용 출처 (쉼표 구분). NODE_ENV=production 일 때만 적용
ALLOWED_ORIGINS=

# 로그 레벨 (기본 info)
LOG_LEVEL=debug

# production 이면 CORS 제한이 켜진다
NODE_ENV=development

# 설정하면 인앱 피드백 기능이 켜진다. 서버 시작 시 유효성을 검증한다.
# 클라이언트에 절대 노출되지 않는다.
DISCORD_WEBHOOK_URL=
